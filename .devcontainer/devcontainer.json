{
  "name": "cookie-store",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.java",
        "vscjava.vscode-java-debug",
        "vscjava.vscode-java-test",
        "vscjava.vscode-maven",
        "vscjava.vscode-gradle",
        "vscjava.vscode-java-dependency",
        "vscjava.vscode-java-pack",
        "GitHub.vscode-pull-request-github",
        "openai.chatgpt"
      ]
    }
  },
  "runArgs": ["--security-opt", "label=disable", "--name", "cookie-store", "--network", "core-facturae_sail"],
  "remoteUser": "vscode",
  "updateRemoteUserUID": false,
  "mounts": [
    "source=gradle-cache-local,target=/home/vscode/.gradle,type=volume"
  ],
  "containerEnv": {
    "JAVA_HOME": "/usr/lib/jvm/msopenjdk-current",
    "OPENROUTER_API_KEY": "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"
  },
  "appPort": [8080],
  "forwardPorts": [8080],
  "portsAttributes": {
  "8080": { "label": "Cookies Store", "onAutoForward": "openBrowser" }
}

  
}
