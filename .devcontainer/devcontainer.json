{
  "name": "cookie-store",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.java",
        "vscjava.vscode-java-debug",
        "vscjava.vscode-java-test",
        "vscjava.vscode-maven",
        "vscjava.vscode-gradle",
        "vscjava.vscode-java-dependency",
        "vscjava.vscode-java-pack",
        "GitHub.vscode-pull-request-github",
        "redhat.java",
        "openai.chatgpt"
      ]
    }
  },
  "runArgs": ["--security-opt", "label=disable", "--name", "cookie-store", "--network", "core-facturae_sail"],
  "remoteUser": "vscode",
  "updateRemoteUserUID": false,
  "mounts": [
    "source=gradle-cache-local,target=/home/vscode/.gradle,type=volume"
  ],
  "containerEnv": {
    "JAVA_HOME": "/usr/lib/jvm/msopenjdk-current",
    "AWS_REGION": "us-east-1",
    "AWS_ENDPOINT_URL": "http://localstack:4566",
    "PULUMI_CONFIG_PASSPHRASE": "",
    "PULUMI_BACKEND_URL": "file:///workspaces/propuesta-demo/infra-application/.pulumi"
  },
  "postCreateCommand": "mkdir -p ~/.aws && printf '[default]\\naws_access_key_id = test\\naws_secret_access_key = test\\n' > ~/.aws/credentials && printf '[default]\\nregion = us-east-1\\n' > ~/.aws/config",
  "appPort": [8080],
  "forwardPorts": [8080],
  "portsAttributes": {
  "8080": { "label": "Cookies Store", "onAutoForward": "openBrowser" }
}

  
}
